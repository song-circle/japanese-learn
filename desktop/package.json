{
  "name": "japanese-listen-desktop",
  "productName": "日本語 듣기",
  "version": "1.0.0",
  "description": "단축키를 누르면 일본어 음성이 나오고 오른쪽 아래에 보기 4개가 뜨는 PC 듣기 연습",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "build:renderer": "vite build --config vite.config.mjs",
    "start": "npm run build:renderer && electron .",
    "dist": "npm run build:renderer && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.songwh.japaneselisten",
    "productName": "日本語 듣기",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "build/**/*",
      "icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": false,
      "runAfterFinish": true
    },
    "artifactName": "japanese-listen-setup-${version}.${ext}"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "vite": "^7.3.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
